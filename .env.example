# ==========================================================
# FaceTrace Configuration Environment Variables
# ==========================================================

# 1. Reverse Image Search API (required for the live pipeline)
SERPAPI_API_KEY=your_serpapi_key_here

# 2. Local Anvil EVM blockchain
# Start with: anvil --host 127.0.0.1 --port 8545
LOCAL_RPC_URL=http://127.0.0.1:8545

# Default first Anvil account private key. Replace for non-demo usage.
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Fill after running: python scripts/deploy_contract.py
CONTRACT_ADDRESS=

# Optional: auto-deploy at app startup when CONTRACT_ADDRESS is empty.
AUTO_DEPLOY_CONTRACT=false

# 3. Server Configuration
PORT=8000
HOST=0.0.0.0
