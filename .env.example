# ==========================================================
# FaceTrace Configuration Environment Variables
# ==========================================================

# 1. Reverse Image Search APIs (Optional - falls back to genuine live web & public domain search)
SERPAPI_API_KEY=your_serpapi_key_here
SEARCH_API_KEY=your_visual_search_api_key_here

# 2. Blockchain EVM Network (Optional - defaults to in-memory EVM simulation for instant local execution)
RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
PRIVATE_KEY=your_testnet_wallet_private_key
CONTRACT_ADDRESS=0x71C67Ed3855aa521e0704673057e6250BE602876

# 3. Server Configuration
PORT=8000
HOST=0.0.0.0
